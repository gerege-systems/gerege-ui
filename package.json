{
  "name": "gerege-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @gerege/site dev",
    "build": "pnpm --filter @gerege/ui build && pnpm --filter @gerege/site build",
    "build:lib": "pnpm --filter @gerege/ui build",
    "build:site": "pnpm --filter @gerege/site build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @gerege/ui test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "size": "size-limit",
    "publint": "publint packages/ui",
    "attw": "attw --pack packages/ui --exclude-entrypoints ./styles.css ./theme.css --ignore-rules cjs-resolves-to-esm",
    "test:create-app": "pnpm --filter @gerege/create-app test",
    "test:treeshake": "pnpm --filter @gerege/ui test:treeshake",
    "test:e2e": "pnpm --filter @gerege/site test:e2e"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/esbuild": "^13.0.3",
    "@size-limit/file": "^13.0.3",
    "eslint": "^9.16.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "publint": "^0.3.24",
    "size-limit": "^13.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
