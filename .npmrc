# The showcase app (apps/site) imports the @gerege-systems/ui source directly via a
# Vite alias for instant HMR. A hoisted node_modules layout guarantees the
# library's runtime deps (radix, lucide, cmdk, …) resolve from the app too.
node-linker=hoisted
# create-app depends on @gerege-systems/ui by version range (the range new
# projects get); resolve it from the workspace, not the registry.
link-workspace-packages=true
